<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FloreHome</RootNamespace>
    <AssemblyName>FloreHome</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- No genera FloreHome.exe: se ejecuta con dotnet.exe (firmado por Microsoft),
         así Windows (Smart App Control) no tiene un .exe sin firma que bloquear. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\flor.png" LogicalName="flor.png" />
    <None Include="conexion.txt" Condition="Exists('conexion.txt')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
